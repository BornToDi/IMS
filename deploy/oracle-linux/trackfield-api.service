[Unit]
Description=TrackField API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=trackfield
Group=trackfield
WorkingDirectory=/opt/trackfield/apps/api
EnvironmentFile=/etc/trackfield/api.env
ExecStartPre=/usr/bin/npm run migrate:deploy
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=5
TimeoutStopSec=20
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/trackfield

[Install]
WantedBy=multi-user.target
