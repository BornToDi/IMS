NODE_ENV=production
PORT=3001
API_URL=http://127.0.0.1:5000
# Browser API and Socket.IO use the website origin by default.
# Only set NEXT_PUBLIC_SOCKET_URL if a separately hosted socket origin is required.
# Configure these after the Android developer supplies the release identity:
# ANDROID_PACKAGE_NAME=com.yourcompany.trackfield
# ANDROID_SHA256_FINGERPRINTS=<full colon-separated SHA-256 fingerprint>
