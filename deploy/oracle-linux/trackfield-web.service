[Unit]
Description=TrackField web application
After=network-online.target trackfield-api.service
Wants=network-online.target

[Service]
Type=simple
User=trackfield
Group=trackfield
WorkingDirectory=/opt/trackfield/apps/web
EnvironmentFile=/etc/trackfield/web.env
ExecStart=/usr/bin/npm start -- -H 127.0.0.1 -p 3000
Restart=always
RestartSec=5
TimeoutStopSec=20
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/trackfield/apps/web/.next

[Install]
WantedBy=multi-user.target
